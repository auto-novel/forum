{
  "name": "forum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter forum-web dev",
    "dev:admin": "pnpm --filter forum-admin dev",
    "build": "pnpm --stream -r run build",
    "test": "pnpm --stream -r --if-present run test"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
